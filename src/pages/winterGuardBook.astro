---
import MainLayout from "../layouts/MainLayout.astro";

import Chapter from "../components/chapter.jsx";
import WinterGuard from "../components/WinterGuard.astro";

import { UnitType } from "../content/unitTypes";

import { getEntry } from "astro:content";

import { DateTime } from "luxon";

const winterShow = await getEntry("winterShow", "winter-show");
const generationDate = DateTime.now();

const showYear = DateTime.fromISO(winterShow.data.show.date).year;

const guardSchools = await Promise.all(
    winterShow.data.winterGuard.lineup
        .filter((li) => li.unitType == UnitType.WinterGuard)
        .map((li) =>
            getEntry(li.ref).then((school) => ({
                ...school.data[li.unit == null ? "winterguard" : li.unit],
                unitType: li.unitType,
            })),
        ),
).then((results) => {
    results.sort((a, b) => a.schoolName.localeCompare(b.schoolName));
    return results;
});

const guardMissingData = guardSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year != showYear,
);
const guardWithData = guardSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year == showYear,
);
---

<MainLayout>
    <div>
        <Chapter>
            <h1>
                {winterShow.data.show.citation} : Winter Guard Announcer's Book: {
                    DateTime.fromISO(winterShow.data.show.date).toLocaleString(
                        DateTime.DATE_FULL,
                    )
                }
            </h1>
            <p>
                {winterShow.data.announcer.name} &lt;{
                    winterShow.data.announcer.email
                }&gt;
            </p>
            <p>
                v{winterShow.data.version}, {
                    generationDate.toLocaleString(DateTime.DATETIME_FULL)
                }
            </p>

            {
                guardMissingData.length > 0 && (
                    <>
                        <h2>Winter Guard Competition - Checkup</h2>

                        <h3>
                            {guardMissingData.length} Schools Missing Winter
                            Guard Data
                        </h3>
                        {guardMissingData.map((s) => (
                            <p>{s.schoolName}</p>
                        ))}
                    </>
                )
            }
        </Chapter>

        <WinterGuard
            winterGuard={winterShow.data.winterGuard}
            show={winterShow.data.show}
        />

        <Chapter>
            <h2>Winter Show - Close</h2>
            <p>
                {
                    `This concludes the ${winterShow.data.show.citation}. Thank you and congratulations to all the units we’ve seen today, and thank you all for attending and cheering on these talented performers.`
                }
            </p>
            <p>
                {
                    `Mark your calendars to join us again next year, on ${DateTime.fromISO(
                        winterShow.data.nextShow.date,
                    ).toLocaleString(
                        DateTime.DATE_FULL,
                    )}, for the ${winterShow.data.nextShow.citation}. On behalf of Foothill High School, I wish you all a safe and enjoyable weekend. Good night.`
                }
            </p>
        </Chapter>
    </div>
</MainLayout>
