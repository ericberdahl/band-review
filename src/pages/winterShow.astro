---
import MainLayout from "../layouts/MainLayout.astro";

import Chapter from "../components/Chapter.astro";

import { UnitType } from "../content/unitTypes";

import { localPathToHrefPath } from "../utils/navigation";

import { getEntry } from "astro:content";

import { DateTime } from "luxon";

const winterShow = await getEntry("winterShow", "winter-show");
const generationDate = DateTime.now();

const showYear = DateTime.fromISO(winterShow.data.show.date).year;

const percussionSchools = await Promise.all(
    winterShow.data.winterPercussion.lineup
        .filter((li) => li.unitType == UnitType.WinterPercussion)
        .map((li) =>
            getEntry(li.ref).then((school) => ({
                ...school.data[li.unit == null ? "winterpercussion" : li.unit],
                unitType: li.unitType,
            })),
        ),
).then((results) => {
    results.sort((a, b) => a.schoolName.localeCompare(b.schoolName));
    return results;
});

const guardSchools = await Promise.all(
    winterShow.data.winterGuard.lineup
        .filter((li) => li.unitType == UnitType.WinterGuard)
        .map((li) =>
            getEntry(li.ref).then((school) => ({
                ...school.data[li.unit == null ? "winterguard" : li.unit],
                unitType: li.unitType,
            })),
        ),
).then((results) => {
    results.sort((a, b) => a.schoolName.localeCompare(b.schoolName));
    return results;
});

const percussionMissingData = percussionSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year != showYear,
);
const percussionWithData = percussionSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year == showYear,
);

const guardMissingData = guardSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year != showYear,
);
const guardWithData = guardSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year == showYear,
);
---

<MainLayout>
    <div>
        <Chapter>
            <h1>
                {winterShow.data.show.citation}: {
                    DateTime.fromISO(winterShow.data.show.date).toLocaleString(
                        DateTime.DATE_FULL,
                    )
                }
            </h1>
            <p>
                {winterShow.data.announcer.name} &lt;{
                    winterShow.data.announcer.email
                }&gt;
            </p>
            <p>
                v{winterShow.data.version}, {
                    generationDate.toLocaleString(DateTime.DATETIME_FULL)
                }
            </p>

            <h2>Table of Contents</h2>
            <ol>
                <li>
                    <a href={localPathToHrefPath("winterPercussionBook.html")}
                        >Winter Percussion</a
                    >
                </li>
                <li>
                    <a href={localPathToHrefPath("winterGuardBook.html")}
                        >Winter Guard</a
                    >
                </li>
                <li><a href="#perc-checkup">Winter Percussion - Checkup</a></li>
                <li><a href="#guard-checkup">Winter Guard - Checkup</a></li>
            </ol>

            <h2 id="perc-checkup">Winter Percussion - Checkup</h2>

            <h3>
                {percussionMissingData.length} Schools Missing Winter Percussion Data
            </h3>
            {percussionMissingData.map((s) => <p>{s.schoolName}</p>)}

            <h3>
                {percussionWithData.length} Schools with Winter Percussion Data
            </h3>
            {percussionWithData.map((s) => <p>{s.schoolName}</p>)}

            <h2 id="guard-checkup">Winter Guard - Checkup</h2>

            <h3>{guardMissingData.length} Schools Missing Winter Guard Data</h3>
            {guardMissingData.map((s) => <p>{s.schoolName}</p>)}

            <h3>{guardWithData.length} Schools with Winter Guard Data</h3>
            {guardWithData.map((s) => <p>{s.schoolName}</p>)}
        </Chapter>
    </div>
</MainLayout>
