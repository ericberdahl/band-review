---
import MainLayout from "../layouts/MainLayout.astro";

import Chapter from "../components/chapter.jsx";

import { UnitType } from "../content/unitTypes";

import { localPathToHrefPath } from "../utils/navigation";

import { getEntry } from "astro:content";

import { DateTime } from "luxon";

const bandReview = await getEntry("bandReview", "band-review");
const generationDate = DateTime.now();

const showYear = DateTime.fromISO(bandReview.data.show.date).year;

const paradeSchools = await Promise.all(
    bandReview.data.parade.lineup
        .filter((li) => li.unitType == UnitType.Parade)
        .map((li) =>
            getEntry(li.ref).then((school) => ({
                ...school.data[li.unit == null ? "parade" : li.unit],
                unitType: li.unitType,
            })),
        ),
).then((results) => {
    results.sort((a, b) => a.schoolName.localeCompare(b.schoolName));
    return results;
});

const fieldShowSchools = await Promise.all(
    bandReview.data.fieldShow.lineup
        .filter((li) => li.unitType == UnitType.FieldShow)
        .map((li) =>
            getEntry(li.ref).then((school) => ({
                ...school.data[li.unit == null ? "fieldshow" : li.unit],
                unitType: li.unitType,
            })),
        ),
).then((results) => {
    results.sort((a, b) => a.schoolName.localeCompare(b.schoolName));
    return results;
});

const paradeMissingData = paradeSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year != showYear,
);
const paradeWithData = paradeSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year == showYear,
);

const fieldShowMissingData = fieldShowSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year != showYear,
);
const fieldShowWithData = fieldShowSchools.filter(
    (s) => DateTime.fromISO(s.lastUpdated).year == showYear,
);
---

<MainLayout>
    <div>
        <Chapter>
            <h1>
                {bandReview.data.show.citation}: {
                    DateTime.fromISO(bandReview.data.show.date).toLocaleString(
                        DateTime.DATE_FULL,
                    )
                }
            </h1>
            <p>
                {bandReview.data.announcer.name} &lt;{
                    bandReview.data.announcer.email
                }&gt;
            </p>
            <p>
                v{bandReview.data.version}, {
                    generationDate.toLocaleString(DateTime.DATETIME_FULL)
                }
            </p>

            <h2>Table of Contents</h2>
            <ol>
                <li>
                    <a href={localPathToHrefPath("paradeBook.html")}>Parade</a>
                </li>
                <li>
                    <a href={localPathToHrefPath("fieldShowBook.html")}
                        >Field Show</a
                    >
                </li>
                <li><a href="#parade-checkup">Parade - Checkup</a></li>
                <li>
                    <a href="#fieldshow-checkup">Field Show - Checkup</a>
                </li>
            </ol>
        </Chapter>

        <h2 id="parade-checkup">Parade - Checkup</h2>

        <h3>{paradeMissingData.length} Schools Missing Parade Data</h3>
        {paradeMissingData.map((s) => <p>{s.schoolName}</p>)}

        <h3>{paradeWithData.length} Schools with Parade Data</h3>
        {paradeWithData.map((s) => <p>{s.schoolName}</p>)}

        <h2 id="fieldshow-checkup">Field Show - Checkup</h2>

        <h3>
            {fieldShowMissingData.length} Schools Missing Field Show Data
        </h3>
        {fieldShowMissingData.map((s) => <p>{s.schoolName}</p>)}

        <h3>{fieldShowWithData.length} Schools with Field Show Data</h3>
        {fieldShowWithData.map((s) => <p>{s.schoolName}</p>)}
    </div>
</MainLayout>
