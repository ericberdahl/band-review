---
import type { GrandMarshalUnit } from "../../content/paradeEventSchema";

import { renderCommaSeparatedList } from "../../utils/listUtils";

interface Props {
    unit: GrandMarshalUnit;
}

const { unit }: Props = Astro.props;
---

<h2>Parade - Grand Marshal</h2>
<p>
    And now… please welcome our {unit.title}, {
        renderCommaSeparatedList(unit.grandMarshal, (gm) => `${gm}`)
    }.
</p>
