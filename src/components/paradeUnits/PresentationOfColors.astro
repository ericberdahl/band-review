---
import type { ColorsUnit } from "../../content/paradeEventSchema";

interface Props {
    unit: ColorsUnit;
}

const { unit }: Props = Astro.props;
---

<h2>Parade - Presentation of the Colors</h2>
<p>
    As we start our parade, please rise if you are able, remove your caps, and
    give your attention and respect to our colors, presented by {unit.colors}.
</p>
