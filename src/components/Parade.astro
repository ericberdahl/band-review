---
import Break from "./Break.astro";
import Chapter from "./Chapter.astro";
import Lineup from "./Lineup.astro";
import NumericCitation from "./NumericCitation.astro";
import TrophySponsor from "./TrophySponsor.astro";

import GrandMarshal from "./paradeUnits/GrandMarshal.astro";
import PresentationOfColors from "./paradeUnits/PresentationOfColors.astro";
import School from "./paradeUnits/School.astro";

import { FieldShowEvent } from "../content/fieldShowEventSchema";
import { ParadeEvent } from "../content/paradeEventSchema";
import { ShowCitation } from "../content/showCitationSchema";
import { UnitType } from "../content/unitTypes";

import { renderCommaSeparatedList } from "../utils/listUtils";

import { getEntry } from "astro:content";

import { DateTime } from "luxon";

interface Props {
    parade: ParadeEvent;
    show: ShowCitation;
    nextShow: ShowCitation;
    fieldShow: FieldShowEvent;
}

const { parade, show, nextShow, fieldShow }: Props = Astro.props;

const fullLineup = await Promise.all(
    parade.lineup.map((li) => {
        if (li.unitType == UnitType.Parade) {
            return getEntry(li.ref).then((school) => ({
                ...school.data[li.unit == null ? "parade" : li.unit],
                unitType: li.unitType,
            }));
        }
        return Promise.resolve(li);
    }),
);

const numSchools = fullLineup.filter(
    (li) => li.unitType == UnitType.Parade,
).length;

const paradeStartUnits = [UnitType.GrandMarshal, UnitType.PresentationOfColors];
const endOfStart = fullLineup.findIndex(
    (element) => !paradeStartUnits.includes(element.unitType),
);

const paradeStartLinup = fullLineup.slice(0, endOfStart);
const paradeLineup = fullLineup.slice(endOfStart);

let schoolCount = 0;
const paradeRenderers = {
    [UnitType.GrandMarshal]: (unit) => ({
        component: GrandMarshal,
        props: { unit },
    }),
    [UnitType.PresentationOfColors]: (unit) => ({
        component: PresentationOfColors,
        props: { unit },
    }),
    [UnitType.Break]: (unit) => ({
        component: Break,
        props: { eventLabel: "Parade", unit },
    }),
    [UnitType.Parade]: (unit) => ({
        component: School,
        props: { unit, isFirst: ++schoolCount === 1 },
    }),
};
---

<div>
    <Chapter>
        <h2>Parade - Open</h2>
        <p>
            Good morning ladies and gentlemen. Welcome to the Parade Competition
            for the {show.citation}. We are joined today by <NumericCitation
                count={numSchools}
            /> wonderful bands to entertain and delight us. Foothill High School wishes
            good luck and good music to all the bands performing today. We hope you
            enjoy the competition.
        </p>
    </Chapter>
    <Chapter>
        <Lineup
            units={paradeStartLinup}
            renderers={paradeRenderers}
            container={Fragment}
        />
        <h2>Parade - Recurring Announcements</h2>
        <ul>
            <li>
                As a courtesy to the performers, spectators please step back
                fully onto the curb to allow the band to use the entire street.
            </li>
            <li>
                As our parade continues, bands will get progressively larger.
            </li>
        </ul>
    </Chapter>

    <Lineup units={paradeLineup} renderers={paradeRenderers} />

    <Chapter>
        <h2>Parade - Close</h2>
        <p>
            This concludes the Parade Competition for the {show.citation}. Thank
            you and congratulations to all the bands we've seen this morning,
            and thank you all for attending and cheering on these talented young
            performers.
        </p>
        <p>
            Parade Awards will be presented at {
                DateTime.fromFormat(parade.awardsTime, "HH:mm").toLocaleString(
                    DateTime.TIME_SIMPLE,
                )
            } in the {parade.awardsLocation}.
        </p>
        <p>
            Please join us at the Foothill High School Stadium for the Field
            Show Competition, starting at {
                DateTime.fromFormat(
                    fieldShow.startTime,
                    "HH:mm",
                ).toLocaleString(DateTime.TIME_SIMPLE)
            } this afternoon and running through this evening.
        </p>
        <p>
            Mark your calendars to join us again next year, on {
                DateTime.fromISO(nextShow.date).toLocaleString(
                    DateTime.DATE_FULL,
                )
            }, for the {nextShow.citation}. On behalf of Foothill High School, I
            wish you all a safe and enjoyable weekend. Good day.
        </p>
    </Chapter>

    <Chapter>
        <h2>Parade and Concert - Awards</h2>
        {
            parade.sponsors.general.length > 0 && (
                <p>
                    {`Foothill High School thanks the sponsors of the ${show.citation}: ${renderCommaSeparatedList(parade.sponsors.general, (s) => `${s}`)}`}
                </p>
            )
        }
        {
            parade.sponsors.trophies.map((t) => (
                <TrophySponsor place={t.place} sponsors={t.sponsors} />
            ))
        }

        <p>(announce scores and awards for Parade and Concert)</p>
    </Chapter>
</div>
