---
import Break from "./Break.astro";
import Chapter from "./Chapter.astro";
import Lineup from "./Lineup.astro";
import NumericCitation from "./NumericCitation.astro";
import TrophySponsor from "./TrophySponsor.astro";

import AnthemPerformer from "./fieldUnits/AnthemPerformer.astro";
import Awards from "./fieldUnits/Awards.astro";
import School from "./fieldUnits/School.astro";

import { type BandReview } from "../content/bandReview";
import { UnitType } from "../content/unitTypes";

import { renderCommaSeparatedList } from "../utils/listUtils";

import { getEntry } from "astro:content";

interface Props {
    event: BandReview;
}

const { event }: Props = Astro.props;

const concert = event.concert;
const fieldShow = event.fieldShow;
const parade = event.parade;
const show = event.show;

const unitCounts = {
    fieldShow: fieldShow.lineup.filter(
        (li) => li.unitType == UnitType.FieldShow,
    ).length,
    parade: parade.lineup.filter((li) => li.unitType == UnitType.Parade).length,
    concert: concert.lineup.filter((li) => li.unitType == UnitType.Concert)
        .length,
};

const fullLineup = await Promise.all(
    fieldShow.lineup.map((li) => {
        if (li.unitType == UnitType.FieldShow) {
            return getEntry(li.ref).then((school) => ({
                ...school.data[li.unit == null ? "fieldshow" : li.unit],
                unitType: li.unitType,
            }));
        }
        return Promise.resolve(li);
    }),
);

const fieldShowtartUnits = [UnitType.AnthemPerformer];
const endOfStart = fullLineup.findIndex(
    (element) => !fieldShowtartUnits.includes(element.unitType),
);

const fieldShowStartLineup = fullLineup.slice(0, endOfStart);
const fieldShowLineup = fullLineup.slice(endOfStart);

const fieldShowRenderers = {
    [UnitType.AnthemPerformer]: (unit) => ({
        component: AnthemPerformer,
        props: { unit },
    }),
    [UnitType.Awards]: (unit) => ({
        component: Awards,
        props: { unit, show, unitCounts },
    }),
    [UnitType.Break]: (unit) => ({
        component: Break,
        props: { eventLabel: "Field Show", unit },
    }),
    [UnitType.FieldShow]: (unit) => ({
        component: School,
        props: { unit, show },
    }),
};
---

<div>
    <Chapter>
        <h2>Field Show - Open</h2>
        <p>
            Good afternoon ladies and gentlemen. Welcome to the Field Show
            Competition for the {show.citation}. We are joined today by <NumericCitation
                count={unitCounts.fieldShow}
            /> talented bands anxious to perform. Foothill High School wishes good
            luck and good music to all the bands performing today. We hope you enjoy
            their shows.
        </p>

        <Lineup
            units={fieldShowStartLineup}
            eventName="field show start"
            renderers={fieldShowRenderers}
            container={Fragment}
        />
    </Chapter>

    <Lineup
        units={fieldShowLineup}
        eventName="field show"
        renderers={fieldShowRenderers}
    />

    <Chapter>
        <h2>Field Show - Awards</h2>
        {
            fieldShow.sponsors.general.length > 0 && (
                <p>
                    {`Foothill High School thanks the sponsors of the ${show.citation}: ${renderCommaSeparatedList(
                        fieldShow.sponsors.general,
                        (s) => `${s}`,
                    )}`}
                </p>
            )
        }

        <h3>General award announcement</h3>
        <p>
            {
                `With a score of ${"{score}"}, ${"{nth}"} place ${"{category}"} goes to [pause] ${"{name of school}"}!`
            }
        </p>

        {
            fieldShow.sponsors.trophies.map((t) => (
                <TrophySponsor place={t.place} sponsors={t.sponsors} />
            ))
        }
    </Chapter>
</div>
