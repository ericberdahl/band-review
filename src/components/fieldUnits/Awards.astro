---
import type { AwardsUnit } from "../../content/fieldShowEventSchema";
import type { BandReview } from "../../content/bandReviewSchema";

import { renderCommaSeparatedList } from "../../utils/listUtils";

interface Props {
    unit: AwardsUnit;
    show: BandReview;
    unitCounts: {
        // TODO give proper type to show
        parade: number;
        concert: number;
        fieldShow: number;
    };
}

const { unit, show, unitCounts }: Props = Astro.props;
---

<h2>{unit.awardsLabel} - Close</h2>
<p>
    {
        `This concludes the ${unit.awardsLabel} Competition for the ${show.citation}. Please stay for the ${unit.awardsLabel} Awards, presented ${unit.location} ${unit.time}. ${
            unit.continuation
                ? `Then please join us for the ${unit.continuation} Competition 
                ${
                    unit.continuationTime &&
                    `starting here ${unit.continuationTime}`
                }.`
                : ``
        }`
    }
</p>
<p>
    {
        `Whether you're from Foothill or cheering your home school, you probably
    know how much work it takes to hold a successful band review, where student
    performers can share their talent with and their love of music. Today, ${renderCommaSeparatedList(
        [
            unitCounts.parade > 0
                ? `${unitCounts.parade} bands marched in parade`
                : null,
            unitCounts.concert > 0
                ? `${unitCounts.concert} performed in concert,`
                : null,
            unitCounts.fieldShow > 0
                ? `${unitCounts.fieldShow} presented field shows`
                : null,
        ].filter((x) => x != null),
        (s) => `${s}`,
    )}. All this would not happen without the work of a small army of student and parent
    volunteers. Foothill High School thanks everyone who contributed to the success
    of today's Band Review.`
    }
</p>
